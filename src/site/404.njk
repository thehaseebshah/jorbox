---
permalink: /404.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="{{ meta.mainLanguage }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Page not found · {{ meta.siteName }}</title>
        <link href="/styles/digital-garden-base.css" rel="stylesheet">
        {%- if meta.themeStyle %}
            <link href="/styles/obsidian-base.css" rel="stylesheet">
            <link href="{{ meta.themeStyle }}" rel="stylesheet">
        {% else %}
            <link href="/styles/style.css" rel="stylesheet">
        {% endif %}
        <link href="/styles/custom-style.css" rel="stylesheet">
    </head>
    <body class="theme-{{ meta.baseTheme }} not-found-page">
        <main class="not-found-card">
            <a href="/" class="not-found-logo" aria-label="Go to {{ meta.siteName }} home">
                <img src="/img/logo-icon.png" alt="" class="not-found-logo-icon">
                <img src="/img/logo-text.png" alt="{{ meta.siteName }}" class="not-found-logo-text">
            </a>
            <p class="not-found-code">404</p>
            <h1>Page not found</h1>
            <p class="not-found-message">This page may have moved, or the note may not be public yet.</p>
            <a href="/" class="not-found-home">Back to Shabab home</a>
        </main>
    </body>
</html>
